ADMIN_USER=admin
ADMIN_PASSWORD=A_REMPLIR
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SWITCH_DB_ENCRYPTION_KEY=A_REMPLIR_CLE_FERNET
# Legacy variables are used only by POST /api/switches/import-legacy, then can be removed.
SW_108E_PASSWORD=A_REMPLIR
SW_108PE_PASSWORD=A_REMPLIR
SW_105PE_PASSWORD=A_REMPLIR
SW_105E_PASSWORD=A_REMPLIR
# Keep false until write operations have been validated on site.
ENABLE_WRITES=false
# Read-only statistics collector. Values are bounded server-side (minimum 30 seconds / 1 day).
STATS_COLLECTION_INTERVAL_SECONDS=60
STATS_RETENTION_DAYS=30
# Live Traffic never queries the switch from the browser. It temporarily raises
# server collection frequency for an actively viewed switch (minimum 5 seconds).
LIVE_COLLECTION_INTERVAL_SECONDS=5
LIVE_CLIENT_TTL_SECONDS=15
